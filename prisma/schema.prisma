datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?    @db.VarChar(255)
  role          String     @default("USER") // "USER", "ADMIN", "SUPER_ADMIN"
  isApproved    Boolean    @default(false)  // Required true for ADMIN to log in
  accounts      Account[]
  sessions      Session[]
  bookmarks     Bookmark[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([role])
  @@index([isApproved])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  slug          String   @unique @db.VarChar(191)
  summary       String   @db.Text
  content       String   @db.LongText
  sport         String   @db.VarChar(50) // "football", "nba", "nfl", "ufc"
  status        String   @default("PUBLISHED") @db.VarChar(20) // "DRAFT" or "PUBLISHED"
  featuredImage String?  @db.VarChar(500)
  seoKeywords   String?  @db.Text
  matchDate     String?  @db.VarChar(100)
  schemaJson    String?  @db.Text
  views         Int      @default(0)
  sharedTwitter   Boolean  @default(false)
  sharedFacebook  Boolean  @default(false)
  sharedPinterest Boolean  @default(false)
  indexedBing     Boolean  @default(false)
  indexedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sport])
  @@index([status])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  matchSlug String   @db.VarChar(191)
  sport     String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  matchTime String?  @db.VarChar(100)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchSlug])
}

model SystemSetting {
  id           String  @id @default("global") @db.VarChar(50)
  postsPerDay  Int     @default(10)
  autoPublish  Boolean @default(true)
  activeSports String  @default("football,nba,nfl,ufc") @db.VarChar(255)
  affforceUrl  String  @default("https://panel.affforce.com/apply/register-affiliate/") @db.VarChar(500)
  vpnUrl       String  @default("https://nordvpn.com") @db.VarChar(500)
  fuboUrl      String  @default("https://www.fubo.tv") @db.VarChar(500)

  // Automated Social Syndication & Instant SEO Indexing
  autoShareSocial      Boolean @default(false)
  autoIndexNow         Boolean @default(true)
  indexNowKey          String? @db.VarChar(100)
  
  // Twitter / X API Credentials
  twitterApiKey        String? @db.VarChar(255)
  twitterApiSecret     String? @db.VarChar(255)
  twitterAccessToken   String? @db.VarChar(255)
  twitterAccessSecret  String? @db.VarChar(255)
  
  // Facebook Graph API
  facebookPageId       String? @db.VarChar(100)
  facebookAccessToken  String? @db.Text
  
  // Pinterest API
  pinterestAccessToken String? @db.Text
  pinterestBoardId     String? @db.VarChar(100)

  // Hero Motion Background & Media Controller
  heroOpacity          Int      @default(80) // 10 to 100 percentage
  heroKenBurns         Boolean  @default(true) // Dynamic camera zoom / motion
  heroCycleSeconds     Int      @default(7) // seconds per star slide
  heroBeamsEnabled     Boolean  @default(true) // sweeping stadium beams
  heroRadarEnabled     Boolean  @default(true) // pitch scanning laser/radar line
  heroScoreTicker      Boolean  @default(true) // live match score ticker
}

model Keyword {
  id          String   @id @default(cuid())
  keyword     String   @unique @db.VarChar(191)
  sport       String   @db.VarChar(50)
  intent      String   @default("COMMERCIAL") @db.VarChar(50) // COMMERCIAL, INFORMATIONAL, NAVIGATIONAL
  volume      Int      @default(10000)
  difficulty  String   @default("MEDIUM") @db.VarChar(20) // LOW, MEDIUM, HIGH
  currentRank Int?     // Google rank position (e.g., 3)
  bestRank    Int?     // Historic best (e.g., 1)
  targetSlug  String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sport])
  @@index([difficulty])
}

model AffiliatePartner {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(50)
  targetUrl   String   @db.VarChar(500)
  category    String   @db.VarChar(50) // CPA Streaming, VPN, Official Pass, Sports Betting
  payout      String   @db.VarChar(100) // "Up to $50 CPA", "40% Recurring"
  clicks      Int      @default(0)
  conversions Int      @default(0)
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SportCategory {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100) // e.g. "Football (Soccer)", "Cricket", "Formula 1"
  slug        String   @unique @db.VarChar(50) // e.g. "football", "cricket", "f1"
  icon        String?  @default("🏆") @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) // Selected / Deselected for AI coverage
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model TicketFixture {
  id               String   @id @default(cuid())
  slug             String   @unique @db.VarChar(191)
  title            String   @db.VarChar(255)
  homeTeam         String   @db.VarChar(100)
  awayTeam         String   @db.VarChar(100)
  sport            String   @default("football") @db.VarChar(50)
  tournament       String   @db.VarChar(100)
  matchDate        String   @db.VarChar(100)
  kickoffUtc       String?  @db.VarChar(100)
  venueName        String   @db.VarChar(150)
  city             String   @db.VarChar(100)
  country          String   @db.VarChar(100)
  venueCapacity    Int      @default(60000)
  stadiumAddress   String   @db.VarChar(255)
  minPrice         Int      @default(89)
  maxPrice         Int      @default(500)
  currency         String   @default("GBP") @db.VarChar(10)
  availableTickets Int      @default(500)
  demandStatus     String   @default("HIGH_DEMAND") @db.VarChar(50)
  featuredImage    String?  @db.VarChar(500)
  seatgeekPrice    Int?     @default(135)
  seatgeekUrl      String?  @db.VarChar(500)
  stubhubPrice     Int?     @default(120)
  stubhubUrl       String?  @db.VarChar(500)
  viagogoPrice     Int?     @default(125)
  viagogoUrl       String?  @db.VarChar(500)
  isActive         Boolean  @default(true)
  offers           TicketOffer[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sport])
  @@index([tournament])
  @@index([isActive])
}

model TicketProvider {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(100) // e.g. "SeatGeek", "StubHub", "Viagogo", "TickPick"
  slug        String        @unique @db.VarChar(50)
  logo        String?       @db.VarChar(500)
  websiteUrl  String        @db.VarChar(500)
  rating      Float         @default(4.8)
  reviewCount Int           @default(15000)
  isActive    Boolean       @default(true)
  offers      TicketOffer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([isActive])
}

model TicketOffer {
  id               String         @id @default(cuid())
  eventId          String
  providerId       String
  seatingTier      String         @db.VarChar(150) // e.g. "Category 1 Lower Longside", "VIP Hospitality"
  tierCategory     String         @default("CAT_1") @db.VarChar(50) // CAT_1, CAT_2, CAT_3, VIP, AWAY
  price            Float
  originalCurrency String         @default("GBP") @db.VarChar(10)
  originalUrl      String?        @db.VarChar(500)
  affiliateUrl     String         @db.VarChar(500)
  availability     String         @default("AVAILABLE") @db.VarChar(50) // AVAILABLE, LOW_STOCK, SOLD_OUT
  isBestValue      Boolean        @default(false)
  instantDownload  Boolean        @default(true)
  guaranteeBadge   String         @default("100% Buyer Guarantee") @db.VarChar(100)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  event            TicketFixture  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider         TicketProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([providerId])
  @@index([price])
}

model HeroScene {
  id                String   @id @default(cuid())
  name              String   @db.VarChar(100) // e.g. "Lionel Messi"
  nickname          String?  @db.VarChar(150) // "The Maestro • 8x Ballon d’Or"
  sport             String   @default("football") @db.VarChar(50) // "football", "cricket", "basketball", etc.
  team              String   @db.VarChar(100) // "Argentina / Inter Miami"
  tournament        String   @db.VarChar(100) // "MLS & International Derby"
  poseTitle         String   @db.VarChar(100) // "Iconic Heavenly Arms Celebration"
  poseDescription   String   @db.VarChar(255) // "Two fingers raised toward the heavens in iconic matchday glory"
  statBadge         String   @default("Superstar 🏆") @db.VarChar(100) // "World Cup Champion 🏆"
  accentColor       String   @default("from-sky-500 via-teal-400 to-emerald-500") @db.VarChar(150)
  borderGlow        String   @default("shadow-sky-500/30 border-sky-500/40") @db.VarChar(150)
  image             String   @db.VarChar(500) // image url (local or remote)
  videoUrl          String?  @db.VarChar(500) // optional mp4 / webm video loop url
  ticketSlug        String   @default("arsenal-vs-chelsea") @db.VarChar(191)
  order             Int      @default(0)
  isActive          Boolean  @default(true)

  // Live in-play scoreboard overlay
  matchCompetition  String?  @default("UEFA Champions Derby") @db.VarChar(100)
  matchMinuteOrOver String?  @default("75' IN-PLAY") @db.VarChar(50)
  matchHomeTeam     String?  @default("MIA") @db.VarChar(50)
  matchAwayTeam     String?  @default("NYC") @db.VarChar(50)
  matchScore        String?  @default("2 - 1") @db.VarChar(50)
  matchLiveAction   String?  @default("Signature free-kick curler into top corner") @db.VarChar(200)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([sport])
  @@index([isActive])
  @@index([order])
}


